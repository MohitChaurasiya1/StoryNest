# StoryNest Environment Variables Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Django core
SECRET_KEY=your-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Gemini AI API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Database — local Docker Compose (PostgreSQL)
DB_HOST=db
DB_NAME=smart_learning
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_PORT=5432

# Database — production (Render / Supabase / Neon full connection string)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (Gmail SMTP — use an App Password, not your real Gmail password)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Frontend API URL (used by Vite dev server only — set on Netlify/Vercel for prod)
VITE_API_BASE_URL=http://localhost:8000/api

# Dev-only: extra emails to receive OTP copies during local testing
DEV_EMAIL_1=
DEV_EMAIL_2=
